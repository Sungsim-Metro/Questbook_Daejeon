# NAVER Cloud Platform Maps 인증 정보다.
# 이 파일을 .env로 복사한 뒤 본인 값을 입력한다.
# NAVER_MAPS_API_KEY_ID는 Dynamic Map SDK 로딩을 위해 브라우저로 전달된다.
NAVER_MAPS_API_KEY_ID=
# NAVER_MAPS_API_KEY는 Geocoding, Reverse Geocoding, 향후 Directions 5 프록시 호출을 위해 로컬 서버에만 둔다.
NAVER_MAPS_API_KEY=

# NAVER API HUB(NCP, 2026-06-25 이후 developers.naver.com 검색 API를 대체한 플랫폼) 인증
# 정보다. 상호명/장소명 검색(지역검색, Local Search)에 쓴다 — Geocoding은 정형 주소만
# 매칭하고 "성심당 본점" 같은 상호명은 못 찾아서 별도로 필요하다. Maps와 마찬가지로
# ID/Secret 두 값 다 필요하고, 서버에만 둔다(브라우저에 노출 금지).
# 발급: NCP 콘솔 → 상단 검색 "API HUB" → Application 생성 → "지역검색(Local Search)" 선택.
NAVER_API_HUB_KEY_ID=
NAVER_API_HUB_KEY=

# 선택적 로컬 개발 서버 설정이다.
QUESTBOOK_HOST=0.0.0.0
QUESTBOOK_PORT=8000
QUESTBOOK_PUBLIC_URL=http://100.87.116.106:8000

# baseline 분리 서버 설정이다.
QUESTBOOK_WEB_HOST=0.0.0.0
QUESTBOOK_WEB_PORT=8000
QUESTBOOK_APP_API_HOST=127.0.0.1
QUESTBOOK_APP_API_PORT=8100
QUESTBOOK_APP_API_BASE_URL=http://127.0.0.1:8100
QUESTBOOK_CACHE_TTL_SECONDS=1800
# docker compose 실행 시 필수 교체: app 컨테이너는 0.0.0.0으로 바인드하므로
# 아래 기본값(약한 시크릿)이면 기동이 거부된다. 다음 명령으로 강한 값을 생성한다:
#   sed -i "s|^QUESTBOOK_JWT_SECRET=.*|QUESTBOOK_JWT_SECRET=$(python3 -c 'import secrets; print(secrets.token_urlsafe(48))')|" .env
QUESTBOOK_JWT_SECRET=questbook-local-dev-secret-change-before-deploy

# PostgreSQL/Redis 로컬 baseline 설정이다.
# 루트 docker-compose.yaml의 기본값과 맞춘다.
QUESTBOOK_DATABASE_URL=postgresql://questbook:questbook_local_password@127.0.0.1:5432/questbook
QUESTBOOK_REDIS_URL=redis://127.0.0.1:6379/0
QUESTBOOK_POSTGRES_DB=questbook
QUESTBOOK_POSTGRES_USER=questbook
QUESTBOOK_POSTGRES_PASSWORD=questbook_local_password
QUESTBOOK_POSTGRES_PORT=5432
QUESTBOOK_REDIS_PORT=6379

# NCP Object Storage 사진 증빙 저장 설정이다.
# 버킷은 비공개로 생성하고, 브라우저에는 API Key를 노출하지 않는다.
NCP_OBJECT_STORAGE_ENDPOINT_URL=https://kr.object.ncloudstorage.com
NCP_OBJECT_STORAGE_REGION_NAME=kr-standard
NCP_OBJECT_STORAGE_BUCKET_NAME=
NCP_OBJECT_STORAGE_ACCESS_KEY=
NCP_OBJECT_STORAGE_SECRET_KEY=
NCP_OBJECT_STORAGE_PRESIGNED_URL_TTL_SECONDS=600
NCP_OBJECT_STORAGE_MAX_UPLOAD_BYTES=10485760
NCP_OBJECT_STORAGE_ADDRESSING_STYLE=path

# NCP CLOVA OCR 영수증 인식 설정이다.
# Invoke URL과 Secret Key는 CLOVA OCR 콘솔에서 발급하고 서버에만 둔다.
NCP_CLOVA_OCR_INVOKE_URL=
NCP_CLOVA_OCR_SECRET_KEY=
NCP_CLOVA_OCR_LANGUAGE=ko
NCP_CLOVA_OCR_TIMEOUT_SECONDS=8

# 한국관광공사 TourAPI 서비스 키다. 비어 있으면 대전 fallback 데이터로 baseline 흐름을 실행한다.
# 공공데이터포털에서 발급한 Decoding 키를 권장하며, Encoding 키를 넣어도 앱 API가 한 번 디코딩한 뒤 호출한다.
# 관광지 목록(locationBasedList2), 설명(detailCommon2), 편의정보(detailIntro2), 오디오 가이드(Odii)
# 조회에 모두 이 키를 그대로 재사용한다.
TOURAPI_SERVICE_KEY=

# Google Cloud Translation API 설정이다. 요청마다 실시간 호출하지 않고, 매일 배치가
# 카탈로그 퀘스트를 새로 만들거나 원문이 바뀌었을 때 TourAPI 영문 데이터(EngService2)가
# 없는 항목만 1회 번역해서 영문 퀘스트 DB에 캐싱하는 용도로 쓴다.
# 발급: Google Cloud Console → APIs & Services → Library에서 "Cloud Translation API" Enable
#       → APIs & Services → Credentials → Create Credentials → API key.
# 무료 할당량은 월 500,000자다(이전에 쓰던 NCP Papago의 월 10,000자보다 훨씬 넉넉함).
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TRANSLATE_TIMEOUT_SECONDS=8
QUESTBOOK_TRANSLATION_CACHE_TTL_SECONDS=2592000

# Gemini는 baseline에서 필수 호출하지 않고 향후 퀘스트 문구 다양화 단계에서 사용한다.
GEMINI_API_KEY=

# OAuth 콜백 redirect_uri의 기준 origin이다. 환경별 예시:
# - 로컬 개발:            http://localhost:8000
# - Tailscale 외부 기기:  http://<MagicDNS이름>:8000  (OAuth 없이 demo-login 테스트용)
# - Tailscale + OAuth:    https://<machine>.<tailnet>.ts.net  (tailscale serve 사용,
#                          네이버/구글 개발자 콘솔에 redirect URI 등록 필요.
#                          구글은 localhost 외 http/IP 리터럴을 거부한다.)
# - 운영:                 https://www.travel-qbook.co.kr
# 참고: docker compose 실행 시 DATABASE_URL/REDIS_URL/APP_API 관련 값은
# compose가 컨테이너 네트워크 값으로 덮어쓰므로 아래 값은 호스트 직접 실행용이다.
QUESTBOOK_PUBLIC_BASE_URL=http://localhost:8000
# 네이버 로그인 자격증명이다(지도 키 NAVER_MAPS_*와 별개).
NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=
# 구글 로그인 자격증명이다.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
